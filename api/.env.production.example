# Production LAN example — copy to .env and adjust IP/paths

PORT=4000
API_PUBLIC_HOST=192.168.1.10:4000

# BASE_DIR=D:\SudutPandangStudio

# Session defaults
SESSION_DURATION_MINUTES=10
THEME_SELF_PHOTO_DURATION_MINUTES=10
AI_SELF_PHOTO_DURATION_MINUTES=12
PAS_PHOTO_DURATION_MINUTES=8
TRIAL_DURATION_SECONDS=60
CAPTURE_COUNTDOWN_SECONDS=3

# --- AI Self Photo (OpenAI Images Edits) ---
AI_GENERATION_ENABLED=true
# OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
# Production gallery — identity-first
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_INPUT_FIDELITY=high
# Research Lab — cheap preview iteration
OPENAI_RESEARCH_IMAGE_QUALITY=low
OPENAI_RESEARCH_IMAGE_INPUT_FIDELITY=low
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_SOURCE_MAX_EDGE=2048
AI_GENERATION_TIMEOUT_MS=120000
AI_GENERATION_MAX_CONCURRENT=2
AI_PROGRESS_HEARTBEAT_MS=2500

# Production: edit + composite only (never full generate)
AI_DEFAULT_PIPELINE_MODE=composite-costume
AI_PIPELINE_FALLBACK_DIRECT=false
AI_ALLOW_DIRECT_PIPELINE=false
FACE_REFINE_ENABLED=true
OPENAI_MASKED_EDIT_ENABLED=true
PERSON_SEGMENTATION_ENABLED=true
PERSON_SEGMENTATION_MODEL=large
PERSON_SEGMENTATION_ALPHA_REFINE=true

# Foto Tema print composite (recommended)
THEME_PROP_OVERLAYS_ENABLED=false
THEME_HARMONIZE_ENABLED=true
THEME_CONTACT_SHADOW=true
THEME_LOOK_BAKE=true
THEME_HAIR_HALO_KILL=0.92
THEME_HAIR_FEATHER=1.65
THEME_ALPHA_FEATHER=1.05
THEME_LIGHT_WRAP=0.22
THEME_EDGE_BG_BLEND=0.94
THEME_BG_BLUR=2.6
THEME_CINEMATIC_FINISH=true
THEME_CINEMATIC_INTENSITY=0.32

IMAGE_PROCESS_MIN_INTERVAL_MS=2000
IMAGE_PROCESS_MAX_JOBS_PER_USER=3

THEME_GENERATION_ENABLED=true
DEFAULT_THEME_ID=wc2026-stadium-night

# Bundled assets (offline, recommended):
# npm run generate:theme-assets -- --category ai-self-photo

# Optional external theme API (server-side only — never expose to frontend)
# THEME_API_PROVIDER=generic
# THEME_API_URL=
# THEME_API_KEY=
# THEME_API_CACHE_ENABLED=true

UPLOAD_MAX_BYTES=20971520

# Optional camera shutter trigger (Windows path to .cmd/.bat)
# CAMERA_CAPTURE_COMMAND=
