# PORT=4000

# # SESSION
# SESSION_DURATION_SECONDS=600

# # COUNTDOWN
# CAPTURE_COUNTDOWN_SECONDS=3

# # CAMERA
# # CAMERA_CAPTURE_COMMAND=your-command-here

# # BACKGROUND REMOVAL (auto only for ai-photo & pas-photo)
# BG_REMOVAL_ENABLED=true

# # AI THEME (local gradient presets by default; optional external API)
# THEME_GENERATION_ENABLED=true
# THEME_API_URL=https://your-theme-api.example/generate
# THEME_API_KEY=your-api-key

# # OPTIONAL
# NODE_ENV=development