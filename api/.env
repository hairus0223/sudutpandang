PORT=4000
API_PUBLIC_HOST=192.168.1.10:4000

# Studio filesystem root (defaults: D:\SudutPandangStudio on Windows, ~/SudutPandangStudio on Mac)
# BASE_DIR=/Users/hairus/Documents/Studio456

# Background removal (auto for ai-photo & pas-photo)
BG_REMOVAL_ENABLED=true
# Windows: keep false — ONNX prewarm can crash Node under PM2
BG_REMOVAL_PREWARM=false
BG_REMOVAL_MODEL=medium

# AI theme generation
THEME_GENERATION_ENABLED=true
DEFAULT_THEME_ID=wc2026-stadium-night
