PORT=4000

# Public host for image URLs emitted to kiosk/gallery (set to LAN IP in production)
# API_PUBLIC_HOST=192.168.1.10:4000

# Studio filesystem root
# Windows default: D:\SudutPandangStudio
# macOS dev default: ~/SudutPandangStudio
# BASE_DIR=D:\SudutPandangStudio

# Session defaults
# SESSION_DURATION_MINUTES=10
# TRIAL_DURATION_SECONDS=60
# CAPTURE_COUNTDOWN_SECONDS=3

# Dev webcam capture (writes to capture/ folder; chokidar moves to active user)
# DEV_WEBCAM_CAPTURE=true

# Sony / Imaging Edge shutter trigger (production)
# CAMERA_CAPTURE_COMMAND="C:\\path\\to\\trigger.cmd"

# Upload limit in bytes (default 20MB)
# UPLOAD_MAX_BYTES=20971520

# Smoke test against running API: npm run smoke-test
# SMOKE_TEST_BASE_URL=http://192.168.1.10:4000

# Promotion Tools (admin-tools) — shared data hub (Phase 0+)
# Defaults: {BASE_DIR}/data/promo-tools.db and {BASE_DIR}/uploads/promo-tools
# PROMO_TOOLS_DB_PATH=D:\SudutPandangStudio\data\promo-tools.db
# PROMO_TOOLS_UPLOAD_DIR=D:\SudutPandangStudio\uploads\promo-tools
# PROMO_TOOLS_IMAGE_MAX_BYTES=8388608
# Products API: GET/POST /api/promo-tools/products
# Image files served at /promo-tools/files/...

# --- AI Self Photo pipeline (OpenAI Images Edits — transform per tema) ---
# AI_GENERATION_ENABLED=true
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
# Production gallery (~$0.08/image): identity-first
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_INPUT_FIDELITY=high
# Research Lab previews (~$0.02/image): cheap iteration
# OPENAI_RESEARCH_IMAGE_QUALITY=low
# OPENAI_RESEARCH_IMAGE_INPUT_FIDELITY=low
# OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
# OPENAI_IMAGE_SOURCE_MAX_EDGE=2048
# AI_SELF_PHOTO_DURATION_MINUTES=12
# AI_GENERATION_TIMEOUT_MS=120000
# AI_GENERATION_MAX_CONCURRENT=2

# Pro booth composite pipeline (PR-2 / PR-3): segment → optional costume → composite
# PERSON_SEGMENTATION_ENABLED=true
# OPENAI_MASKED_EDIT_ENABLED=true
# FACE_REFINE_ENABLED=true
# AI_DEFAULT_PIPELINE_MODE=composite-costume
# AI_PIPELINE_FALLBACK_DIRECT=true
# Prop/frame overlays on composite result (PR-5, default on)
# THEME_PROP_OVERLAYS_ENABLED=true

# OpenAI cost estimates (USD per image edit — for analytics dashboard)
# OPENAI_COST_USD_LOW_LOW=0.02
# OPENAI_COST_USD_MEDIUM_HIGH=0.08
# OPENAI_COST_RESEARCH_USD=0.02
# OPENAI_COST_PRODUCTION_USD=0.08

# Published AI themes override (optional):
# {BASE_DIR}/config/ai-themes.json  — merge/override bundled themes (publish from research lab)

# Admin — AI Theme Research Lab (PR-3)
# ADMIN_API_TOKEN=your-secret-token
# Send header: X-Admin-Token: your-secret-token
# AI_RESEARCH_IMAGE_MAX_BYTES=20971520

# Theme preview samples for registration cards:
# Bundled: api/assets/ai-theme-previews/{theme-id}/after.png
# Override: {BASE_DIR}/themes/{theme-id}/after.jpg  → served at /themes/...
# Composite background (Pro Booth PR-1):
# Bundled portrait photos: api/assets/theme-backgrounds/{theme-id}/bg.jpg → /theme-backgrounds/...
# Studio override: {BASE_DIR}/themes/{theme-id}/bg.jpg → /themes/...
# Legacy SVG card fallback: /theme-assets/ai-self-photo/{theme-id}.png
# Generate bundled: npm run generate:theme-backgrounds
# Photorealistic (OpenAI): npm run generate:theme-backgrounds:openai
# OPENAI_BACKGROUND_QUALITY=medium
# Prop overlays: api/assets/theme-overlays/{theme-id}/frame.png → npm run generate:theme-overlays
# Registration previews: npm run generate:ai-theme-previews
# Production gate: npm run validate:ai-booth-production
