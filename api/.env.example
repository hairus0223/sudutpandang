PORT=4000

# Public host for image URLs emitted to kiosk/gallery (set to LAN IP in production)
# API_PUBLIC_HOST=192.168.1.10:4000

# Studio filesystem root
# Windows default: D:\SudutPandangStudio
# BASE_DIR=D:\SudutPandangStudio

# Background removal (auto for ai-photo & pas-photo packages)
BG_REMOVAL_ENABLED=true
# Model: small | medium (bundled offline). "large" is NOT in npm — auto-falls back to medium.
BG_REMOVAL_MODEL=medium
# Max long edge before remove-bg (keeps detail, avoids OOM)
# BG_REMOVAL_MAX_INPUT_PX=4096
# Post-process alpha matte refinement (default true)
# BG_REMOVAL_REFINE_EDGES=true
# Recover subject parts trimmed by the model (default true)
# BG_REMOVAL_ALPHA_PRESERVE=true
# BG_REMOVAL_ALPHA_DILATE=1.08
# BG_REMOVAL_ALPHA_OFFSET=6
# Subtle alpha edge anti-aliasing (default true; set false for raw model output)
# BG_REMOVAL_ALPHA_REFINE=true
# Max wait per remove-bg job in milliseconds
BG_REMOVAL_TIMEOUT_MS=120000
# Pre-load model on API startup (recommended for studio)
# Windows PM2: keep false (ONNX prewarm can segfault). Linux/mac: true is OK.
BG_REMOVAL_PREWARM=false
# Deep ONNX probe on GET /api/health/image-processing (default: assets-only)
# BG_REMOVAL_HEALTH_PROBE=true

# Composite jobs (passport / theme) timeout in milliseconds
IMAGE_COMPOSITE_TIMEOUT_MS=60000

# AI theme generation
THEME_GENERATION_ENABLED=true
# Default theme for new ai-photo sessions (must match api/services/themePresets.js)
DEFAULT_THEME_ID=wc2026-stadium-night

# Generate bundled theme assets once after install:
# npm run generate:theme-assets
# npm run generate:theme-assets -- --category world-cup-2026
# npm run generate:theme-assets -- --event
# Pre-event checklist: npm run event:preflight

# Optional external theme API (used when bundled asset missing; result cached to disk)
# THEME_API_PROVIDER=generic
# generic: POST { prompt, width, height } → image bytes
# huggingface (or hf): THEME_API_URL = model id or full HF inference URL
# THEME_API_URL=
# THEME_API_KEY=
# THEME_API_TIMEOUT_MS=90000
# THEME_API_CACHE_ENABLED=true
# THEME_API_CACHE_DIR=api/assets/themes/cache

# Upload limit in bytes (default 20MB)
# UPLOAD_MAX_BYTES=20971520

# Manual image process rate limit (gallery sandbox)
IMAGE_PROCESS_MIN_INTERVAL_MS=2000
IMAGE_PROCESS_MAX_JOBS_PER_USER=3

# Smoke test against running API: npm run smoke-test
# SMOKE_TEST_BASE_URL=http://192.168.1.10:4000

# Promotion Tools (admin-tools) — shared data hub (Phase 0+)
# Defaults: {BASE_DIR}/data/promo-tools.db and {BASE_DIR}/uploads/promo-tools
# PROMO_TOOLS_DB_PATH=D:\SudutPandangStudio\data\promo-tools.db
# PROMO_TOOLS_UPLOAD_DIR=D:\SudutPandangStudio\uploads\promo-tools
# PROMO_TOOLS_IMAGE_MAX_BYTES=8388608
# Products API: GET/POST /api/promo-tools/products
# Image files served at /promo-tools/files/...
